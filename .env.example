NEXT_PUBLIC_SITE_URL=https://steevanz.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# Supabase Auth «Send Email Hook» secret (v1,whsec_...): see docs/auth-email-config.md
SEND_EMAIL_HOOK_SECRET=
ADMIN_EMAILS=rcabaco@steevanz.com
CRON_SECRET=

# Reader (scripts/reader, the only source of reviews): browser tabs at once (default 4; 10 on a server)
READER_SLOTS=10
# Site the reader calls for the 10:00/19:00 competitor slot and negative-review alerts
# (the deployment in use, e.g. the login-page preview; http://localhost:3000 only with next dev running)
READER_SITE_URL=https://steevanz.com

# «Ligar ao Google» (Google Business Profile, OAuth). Without all three the button still works but
# explains that the connection isn't active yet. Redirect URI to register: <origin>/api/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts the stored tokens: never change it
# once customers are connected (they would have to connect again).
GOOGLE_TOKEN_KEY=

# Queue push notifications (web-push, free). Generate once with `npx web-push generate-vapid-keys`;
# never change them afterwards (phones that enabled alerts would stop getting them).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:rcabaco@steevanz.com
